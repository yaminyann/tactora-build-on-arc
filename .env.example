# Copy to .env and fill in. Never commit .env. Secrets stay on the backend (never prefix them with VITE_).

# --- Frontend (public values) ---
# Network a first-time visitor opens on: arc-testnet or arc
# VITE_DEFAULT_NETWORK=arc-testnet
# Browser RPC (build time). One URL or a comma-separated list, tried in order. Unset uses the public endpoint, which rate-limits.
# VITE_RPC_URL_ARC_TESTNET=https://rpc.testnet.arc.io
# VITE_RPC_URL_ARC=https://rpc.mainnet.arc.io
# Circle passkey wallet (fingerprint). Public values, build time. Client Key + Passkey Domain: docs/api-keys.md
# Without a key the passkey option is hidden and browser wallets work as before.
# VITE_CIRCLE_CLIENT_KEY=TEST_API_KEY:...
# VITE_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
# Gas Station sponsoring: default true on testnet, false on mainnet (needs a policy in the Circle Console first)
# VITE_CIRCLE_SPONSOR_GAS=true
# Footer links. A social link shows only when set (https only).
# VITE_SOCIAL_X=https://x.com/yourhandle
# VITE_SOCIAL_DISCORD=https://discord.gg/yourinvite
# VITE_SOCIAL_TELEGRAM=https://t.me/yourchannel
# VITE_SOCIAL_GITHUB=https://github.com/yaminyann/dex-on-arc
# VITE_DOCS_URL=
# VITE_SUPPORT_URL=
# VITE_TERMS_URL=
# VITE_PRIVACY_URL=
VITE_ORDERS_ADDRESS_ARC_TESTNET=0xa83efe842010dbd470dfe7cc210d61c4edd908aa
VITE_ORDERS_DEPLOY_TX_ARC_TESTNET=
# VITE_ORDERS_ADDRESS_ARC_MAINNET=
# VITE_ORDERS_DEPLOY_TX_ARC_MAINNET=
# Extra reviewed swap contracts the browser may send market swaps to on Arc mainnet (comma-separated)
# VITE_SWAP_TARGETS_ARC=

# --- RPC ---
RPC_URL_Arc_Testnet=https://rpc.testnet.arc.io
# RPC_URL_Arc=https://rpc.mainnet.arc.io,https://your-second-provider.example
KEEPER_WS_URL=wss://rpc.testnet.arc.io

# --- Backend ---
API_PORT=3001
ADMIN_TOKEN=
TRUSTED_PROXY_HOPS=0
# ALLOWED_ORIGINS=https://app.example.com
# ZEROEX_API_KEY=
# Fee on browser market swaps, in bps of the sell amount (0 = off, max 100). Paid by the aggregator to the recipient.
# 30 = 0.30%. Set the rate yourself: it is a business decision, and it is off until you do.
# PLATFORM_FEE_BPS=30
PLATFORM_FEE_RECIPIENT=0x378862A20B312298dc54585CbabC531D70F9baE9
# Platform dashboard (statistics, users, revenue, API keys). Wallets that may sign in, comma-separated.
# Plain wallets only (MetaMask, Rabby, hardware). The ADMIN_TOKEN above stays as the break-glass key.
PLATFORM_ADMIN_ADDRESSES=0x378862A20B312298dc54585CbabC531D70F9baE9
# Lets the dashboard save API keys, encrypted in DATA_DIR/secrets.json. At least 16 random characters; keep a copy.
# Generate one: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# SECRETS_ENCRYPTION_KEY=
# Agent chat model (optional). The admin picks the provider and model in the app (Platform page > Agent chat model),
# with an optional second one as fallback. These only hold the keys. Where to get each: docs/api-keys.md
# OpenRouter: https://openrouter.ai/keys (models ending in :free cost nothing)
# OPENROUTER_API_KEY=
# Gemini: https://aistudio.google.com/apikey (free tier)
# GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys (paid, no free tier)
# OPENAI_API_KEY=
# Any other OpenAI-compatible server (a local Ollama costs nothing): the "Custom" provider.
# AGENT_LLM_URL=http://localhost:11434/v1
# AGENT_LLM_MODEL=llama3.2:3b
# AGENT_LLM_API_KEY=
# Hard cap on model calls per day, all users together
# AGENT_LLM_DAILY_CALLS=2000
# Folder for the admin's saved choices (agent-llm.json). Keep it on a volume. Default ./data
# DATA_DIR=./data
# Free market data (DexScreener for prices, GeckoTerminal for candles) needs no key. GeckoTerminal allows ~30 calls/min.
# GECKO_CALLS_PER_MIN=24
# GATEWAY_PROVIDERS=0x,kyber,test-router,test-router-b
# ALERT_WEBHOOK_URL=

# --- Keeper (testnet uses the throwaway deployer key; mainnet uses its own dedicated low-balance key) ---
# KEEPER_ENABLED=true
KEEPER_NETWORK=arc-testnet
KEEPER_INTERVAL_MS=5000
# KEEPER_PRIVATE_KEY=
# KEEPER_PRIVATE_KEY_FILE=/run/secrets/keeper_key
# KEEPER_ROLE=standby
# KEEPER_BACKOFF_BASE_MS=5000
# KEEPER_BACKOFF_MAX_MS=60000

# --- Indexer ---
INDEXER_ENABLED=true
INDEXER_NETWORK=arc-testnet
INDEXER_INTERVAL_MS=5000
# DATABASE_URL=postgres://user:pass@host:5432/arc_terminal

# --- Testnet harness scripts only ---
# TESTNET_DEPLOYER_PRIVATE_KEY=
